[Unit]
Description=Independent Telegram Guess Number Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-guess-bot
EnvironmentFile=/etc/tg-guess-bot.env
ExecStart=/usr/bin/python3 /opt/tg-guess-bot/app.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
